---
import Logo from "@/components/brand/Logo.astro";
import { MAIN_NAV, PROMO_TEXT, SITE } from "@/config/site";

const currentPath = Astro.url.pathname;

/** Marca el link activo, tolerando el slash final. */
function isActive(href: string): boolean {
  const normalize = (path: string) => (path !== "/" ? path.replace(/\/$/, "") : path);
  return normalize(currentPath) === normalize(href);
}
---

{/* Barra promo sobre el header (mono, negra) — definida en el handoff. */}
<div
  class="bg-ink px-4 py-2 text-center font-mono text-[11px] tracking-[.08em] text-cream uppercase"
>
  {PROMO_TEXT}
</div>

<header
  class="sticky top-0 z-50 flex min-h-(--header-height) flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-ink bg-cream px-5 py-2 sm:px-10 sm:py-0"
>
  {
    /* El nombre accesible lo da el aria-label del enlace, así que el logo va
      como decorativo para no anunciarlo dos veces. En pantallas chicas se
      deja solo la marca: el wordmark no entra sin apretar la navegación. */
  }
  <a href="/" class="no-underline" aria-label={`${SITE.name} — ir al inicio`}>
    <Logo size={34} title={null} class="hidden sm:inline-flex" />
    <Logo size={34} variant="mark" title={null} class="sm:hidden" />
  </a>

  <nav aria-label="Navegación principal">
    <ul class="flex items-center gap-4 text-sm font-semibold sm:gap-7">
      {
        MAIN_NAV.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class="no-underline transition-colors hover:text-coral aria-[current=page]:text-coral"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    /* Sigue siendo un enlace real a /carrito: cart-ui.ts intercepta el clic
      para abrir el panel lateral solo cuando ese island ya está montado. Si
      falla el JS, el enlace lleva a la página completa igual. */
  }
  <a
    href="/carrito"
    data-cart-open
    class="flex items-center gap-2.5 border border-ink px-4 py-2 text-[13px] font-bold no-underline transition-colors hover:bg-ink hover:text-cream"
  >
    Carrito
    <span data-cart-count class="bg-coral px-[7px] py-px font-mono text-xs text-ink">0</span>
  </a>
</header>
