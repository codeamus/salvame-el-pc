---
import Logo from "@/components/brand/Logo.astro";
import { enlaces, getSettings, texto } from "@/data/content";

const currentYear = new Date().getFullYear();

const ajustes = await getSettings();
const nombreSitio = texto(ajustes, "site.name", "Sálvame el PC");
const bajada = texto(ajustes, "footer.tagline");
const notaPagos = texto(ajustes, "footer.payment_note");
const whatsappUrl = texto(ajustes, "contact.whatsapp_url", "#");
const redes = enlaces(ajustes, "contact.redes");
const whatsappDisplay = texto(ajustes, "contact.whatsapp_display");
const navTienda = enlaces(ajustes, "nav.footer_tienda");
const navAyuda = enlaces(ajustes, "nav.footer_ayuda");
---

<footer class="bg-invert text-on-invert">
  <div
    class="grid grid-cols-1 gap-8 px-5 pt-14 pb-10 sm:grid-cols-2 sm:px-10 lg:grid-cols-[2fr_1fr_1fr_1fr]"
  >
    <div>
      {
        /* Sobre tinta el ícono toma crema solo: sus trazos usan currentColor,
          y el texto del wordmark ya hereda el color del footer. */
      }
      <Logo size={46} title={null} />
      <p class="mt-3 max-w-[34ch] text-[13px] leading-relaxed text-on-invert-muted">
        {bajada}
      </p>
    </div>

    <nav aria-label="Tienda" class="flex flex-col gap-2.5 text-sm">
      <span class="font-mono text-[11px] tracking-[.14em] text-on-invert-faint uppercase"
        >Tienda</span
      >
      {
        navTienda.map((link) => (
          <a href={link.href} class="text-on-invert/85 no-underline hover:text-coral">
            {link.label}
          </a>
        ))
      }
    </nav>

    <nav aria-label="Ayuda" class="flex flex-col gap-2.5 text-sm">
      <span class="font-mono text-[11px] tracking-[.14em] text-on-invert-faint uppercase"
        >Ayuda</span
      >
      {
        navAyuda.map((link) => (
          <a href={link.href} class="text-on-invert/85 no-underline hover:text-coral">
            {link.label}
          </a>
        ))
      }
    </nav>

    <nav aria-label="Redes sociales" class="flex flex-col gap-2.5 text-sm">
      <span class="font-mono text-[11px] tracking-[.14em] text-on-invert-faint uppercase"
        >Síguenos</span
      >
      {
        /* Se dibujan desde la lista de ajustes: agregar una red es editar un
           JSON en el panel, no tocar este archivo. */
        redes.map((red) => (
          <a
            href={red.href}
            target="_blank"
            rel="noopener"
            class="text-on-invert/85 no-underline hover:text-coral"
          >
            {red.label}
          </a>
        ))
      }
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener"
        class="text-on-invert/85 no-underline hover:text-coral"
      >
        WhatsApp {whatsappDisplay}
      </a>
    </nav>
  </div>

  <div
    class="flex flex-wrap justify-between gap-4 border-t border-on-invert-line px-5 py-4.5 font-mono text-[11px] text-on-invert-faint sm:px-10"
  >
    <span>© {currentYear} {nombreSitio} — Santiago, Chile</span>
    <span>{notaPagos}</span>
  </div>
</footer>
