---
import { THEME_COLOR, THEME_STORAGE_KEY } from "@/lib/theme";

/**
 * Modo oscuro sin flash.
 *
 * Corre en línea y en el <head> porque es lo único que ocurre ANTES del
 * primer pintado. Cualquier otra opción —un módulo, un script al final del
 * body, un efecto de React— llega después de que el navegador ya dibujó la
 * página en claro, y el visitante ve el parpadeo blanco que este bloque
 * existe para evitar.
 *
 * Solo escribe el atributo cuando hay una elección guardada: sin atributo,
 * la media query de tokens.css sigue al sistema sola. El resto del
 * comportamiento (el clic, la etiqueta) vive en theme-ui.ts, que sí puede
 * esperar.
 *
 * Vive en su propio componente, y no copiado en cada layout, porque el
 * panel de administración necesita exactamente el mismo comportamiento: dos
 * copias de esto se desincronizan en cuanto alguien cambie la clave de
 * localStorage en una sola.
 */
---

<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY, themeColor: THEME_COLOR }}>
  (function () {
    var stored = null;
    try {
      stored = localStorage.getItem(storageKey);
    } catch (error) {
      /* Navegación privada o bloqueador: se sigue al sistema. */
    }

    if (stored === "light" || stored === "dark") {
      document.documentElement.dataset.theme = stored;
    }

    var dark =
      stored === "dark" ||
      (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);

    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", dark ? themeColor.dark : themeColor.light);
  })();
</script>
