---
import { Image } from "astro:assets";
import { cn } from "@/lib/cn";
import { productViewTransitionName, type Product } from "@/types/product";

interface Props {
  product: Product;
  class?: string;
  /** Carga la imagen con prioridad (solo para las primeras del viewport). */
  eager?: boolean;
  /**
   * Participa de la view transition card → single. Se apaga cuando el mismo
   * producto ya apareció antes en la página: dos elementos con el mismo
   * view-transition-name abortan la transición completa.
   */
  vt?: boolean;
  /** Vacío = decorativa (el nombre del producto ya está al lado en la card). */
  alt?: string;
  /**
   * Velo coral que se levanta al pasar el cursor por la card. Requiere que
   * algún ancestro tenga la clase `group`, que es quien detecta el hover.
   */
  veil?: boolean;
}

const { product, class: className, eager = false, vt = true, alt = "", veil = false } = Astro.props;

/*
 * Las medidas son obligatorias con una imagen remota: Astro no puede
 * mirarla sin descargarla, y descargarla en cada render sería exactamente
 * el gasto que esto viene a evitar.
 *
 * No recortan nada. El contenedor manda —aspect-4/3 con object-cover— y
 * estos números solo le dicen a Vercel a qué tamaño servirla y al navegador
 * qué espacio reservar. 800 de ancho cubre la card más grande en pantallas
 * de retina.
 */
const ANCHO = 800;
const ALTO = 600;
---

{
  /* Si la foto no carga, photo-fallback.ts la oculta y queda el placeholder
    rayado con caption mono — comportamiento definido en el handoff. */
}
<div
  class={cn(
    "stripes relative flex items-center justify-center overflow-hidden",
    veil && "photo-veiled",
    className,
  )}
  style={vt ? { viewTransitionName: productViewTransitionName(product) } : undefined}
>
  <span class="px-2 text-center font-mono text-[11px] text-faint" aria-hidden="true">
    {product.photoCaption}
  </span>
  <Image
    src={product.photo}
    alt={alt}
    width={ANCHO}
    height={ALTO}
    quality={78}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    data-photo-fallback
    class="absolute inset-0 h-full w-full object-cover"
  />
  {
    /* Va después de la foto y antes del slot: tiñe la imagen, pero los badges
      que llegan por slot se pintan encima y quedan sin teñir. */
  }
  {veil && <span class="photo-veil" aria-hidden="true" />}
  <slot />
</div>
