---
import ProductPhoto from "@/components/product/ProductPhoto.astro";
import { formatCLP } from "@/lib/format";
import { getDiscountPercent, type Product } from "@/types/product";

interface Props {
  product: Product;
  /** Carga la imagen con prioridad (solo para las primeras del viewport). */
  eager?: boolean;
  /** Ver nota en ProductPhoto: apagar si el producto ya apareció en la página. */
  vt?: boolean;
  /** Velo coral sobre la foto, que se levanta al pasar el cursor por la card. */
  veil?: boolean;
}

const { product, eager = false, vt = true, veil = false } = Astro.props;
const { slug, name, brand, priceCLP, compareAtPriceCLP } = product;

const discount = getDiscountPercent(product);
const href = `/producto/${slug}`;

/* Payload para la delegación de cart-ui.ts (ver el módulo). */
const cartPayload = JSON.stringify({
  id: product.id,
  slug,
  name,
  brand,
  photo: product.photo,
  priceCLP,
});
---

{
  /*
  `relative` es OBLIGATORIO acá, no decorativo: el enlace del título usa
  `after:absolute after:inset-0` para que toda la tarjeta sea clickeable, y
  ese pseudo-elemento se posiciona contra el ancestro posicionado más cercano.
*/
}
<article class="group hover-lift-coral relative flex flex-col border border-line bg-cream">
  <ProductPhoto
    product={product}
    eager={eager}
    vt={vt}
    veil={veil}
    class="aspect-4/3 border-b border-line"
  >
    {
      discount !== null && (
        <span class="absolute top-2.5 left-2.5 border border-line bg-coral px-2 py-0.5 font-mono text-[11px] font-bold text-on-coral">
          -{discount}%
        </span>
      )
    }
  </ProductPhoto>

  <div class="flex flex-1 flex-col gap-1 p-4 pt-3.5">
    <p class="font-mono text-[11px] text-coral uppercase">{brand}</p>

    <h3 class="flex-1 text-[15px] leading-[1.3] font-bold">
      {
        /* El enlace cubre toda la tarjeta vía ::after, pero el texto accesible
          sigue siendo el nombre del producto — no un "ver más" genérico. */
      }
      <a href={href} class="no-underline after:absolute after:inset-0">{name}</a>
    </h3>

    <div class="mt-2 flex items-baseline gap-2">
      <span class="font-mono text-[15px] font-bold">{formatCLP(priceCLP)}</span>
      {
        compareAtPriceCLP !== undefined && (
          <s class="font-mono text-xs text-muted-soft">{formatCLP(compareAtPriceCLP)}</s>
        )
      }
    </div>

    {
      /*
      Selector de cantidad + agregar.

      `relative z-10` es obligatorio: el enlace del nombre cubre toda la card
      con un ::after, así que sin elevar esta fila los clics caerían en el
      enlace y navegarían a la ficha en vez de sumar unidades.

      La cantidad vive en el DOM (data-qty-value) y no en un estado de React:
      la grilla del catálogo son 12 cards y no vale la pena hidratar un
      framework para un número. Lo maneja cart-ui.ts por delegación.
    */
    }
    <div class="relative z-10 mt-2.5 flex items-stretch gap-2" data-qty-form>
      <div class="flex shrink-0 border border-line" role="group" aria-label={`Cantidad de ${name}`}>
        <button
          type="button"
          data-qty-dec
          aria-label={`Menos unidades de ${name}`}
          class="h-8 w-8 cursor-pointer border-none bg-transparent text-base leading-none transition-colors hover:bg-coral hover:text-on-coral"
        >
          −
        </button>
        <span
          data-qty-value
          aria-live="polite"
          class="flex w-8 items-center justify-center border-x border-line font-mono text-[13px] font-bold"
        >
          1
        </span>
        <button
          type="button"
          data-qty-inc
          aria-label={`Más unidades de ${name}`}
          class="h-8 w-8 cursor-pointer border-none bg-transparent text-base leading-none transition-colors hover:bg-coral hover:text-on-coral"
        >
          +
        </button>
      </div>

      <button
        type="button"
        data-add-to-cart={cartPayload}
        aria-label={`Agregar ${name} al carrito`}
        class="flex-1 cursor-pointer border border-line bg-transparent px-2 text-[13px] font-bold whitespace-nowrap transition-colors hover:bg-coral hover:text-on-coral"
      >
        Agregar
      </button>
    </div>
  </div>
</article>
