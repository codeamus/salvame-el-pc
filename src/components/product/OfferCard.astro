---
import ProductPhoto from "@/components/product/ProductPhoto.astro";
import { formatCLP } from "@/lib/format";
import { getDiscountPercent, type Product } from "@/types/product";

/**
 * Card horizontal de "Ofertas de la semana": foto 42% a la izquierda,
 * badge negro con el descuento y precio anterior tachado.
 */
interface Props {
  product: Product;
  /** Ver nota en ProductPhoto: apagar si el producto ya apareció en la página. */
  vt?: boolean;
  /** Velo coral sobre la foto, que se levanta al pasar el cursor por la card. */
  veil?: boolean;
}

const { product, vt = true, veil = false } = Astro.props;
const discount = getDiscountPercent(product);
---

{
  /* La foto lleva proporción fija: sin ella la altura de la card la marcaba
    solo el texto, y en pantallas anchas quedaba de 109 px con la foto
    reducida a una franja. Con el aspecto atado al ancho, la card crece con
    la pantalla en vez de aplastarse. */
}
{
  /* `text-ink` explícito y no heredado: esta card vive dentro de la banda
    coral, que fija su texto en oscuro para leerse sobre el coral. Sin
    declararlo acá, en modo oscuro la card heredaba ese texto oscuro sobre su
    propio fondo oscuro y quedaba ilegible. */
}
<article class="group hover-lift-ink relative flex border border-line bg-cream text-ink">
  <ProductPhoto
    product={product}
    vt={vt}
    veil={veil}
    class="aspect-4/3 w-[42%] shrink-0 border-r border-line"
  />

  <div class="flex flex-1 flex-col gap-1 p-4">
    {
      discount !== null && (
        <span class="self-start bg-ink px-2 py-0.5 font-mono text-[11px] font-bold text-cream">
          -{discount}%
        </span>
      )
    }
    <h3 class="mt-1.5 flex-1 text-sm leading-[1.3] font-bold">
      <a href={`/producto/${product.slug}`} class="no-underline after:absolute after:inset-0">
        {product.name}
      </a>
    </h3>
    <div class="flex items-baseline gap-2">
      <span class="font-mono text-[15px] font-bold">{formatCLP(product.priceCLP)}</span>
      {
        product.compareAtPriceCLP !== undefined && (
          <s class="font-mono text-xs text-muted-soft">{formatCLP(product.compareAtPriceCLP)}</s>
        )
      }
    </div>
  </div>
</article>
