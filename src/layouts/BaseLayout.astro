---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { SITE } from "@/config/site";
import { THEME_COLOR, THEME_STORAGE_KEY } from "@/lib/theme";
import "@/styles/global.css";

interface Props {
  /** Título de la página, sin el nombre del sitio (se agrega solo). */
  title: string;
  description?: string;
  /** Ruta de imagen para compartir en redes (Open Graph). */
  ogImage?: string;
}

const { title, description = SITE.description, ogImage = "/og-default.png" } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url);
const fullTitle = `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={THEME_COLOR.light} />
    <meta name="generator" content={Astro.generator} />

    {
      /*
        Modo oscuro sin flash.

        Corre acá, en línea y en el <head>, porque es lo único que ocurre
        ANTES del primer pintado. Cualquier otra opción —un módulo, un
        script al final del body, un efecto de React— llega después de que
        el navegador ya dibujó la página en claro, y el visitante ve el
        parpadeo blanco que este bloque existe para evitar.

        Solo escribe el atributo cuando hay una elección guardada: sin
        atributo, la media query de tokens.css sigue al sistema sola. El
        resto del comportamiento (el clic, la etiqueta) vive en
        theme-ui.ts, que sí puede esperar.
      */
    }
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY, themeColor: THEME_COLOR }}>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem(storageKey);
        } catch (error) {
          /* Navegación privada o bloqueador: se sigue al sistema. */
        }

        if (stored === "light" || stored === "dark") {
          document.documentElement.dataset.theme = stored;
        }

        var dark =
          stored === "dark" ||
          (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);

        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", dark ? themeColor.dark : themeColor.light);
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* View Transitions nativas: la foto del producto viaja de card → single. */}
    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <Header />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Footer />

    {
      /* Contenedor del panel del carrito. Se llena bajo demanda desde
        cart-ui.ts la primera vez que se abre; ver mount-cart-drawer.tsx.
        `transition:persist` evita que el ClientRouter lo reemplace al
        navegar y deje la raíz de React colgando de un nodo huérfano. */
    }
    <div id="cart-drawer-root" transition:persist></div>

    {/* Toast global "Agregado: … · ver carrito". Lo muestra cart-ui.ts. */}
    <div
      data-toast
      hidden
      role="status"
      aria-live="polite"
      class="fixed bottom-6 left-1/2 z-100 -translate-x-1/2 border border-coral bg-invert px-6 py-3 font-mono text-xs whitespace-nowrap text-on-invert"
    >
      <span data-toast-message></span> ·
      <a href="/carrito" class="text-coral underline">ver carrito</a>
    </div>

    {
      /* Estado compartido del header/toast y fallback de fotos rotas —
        corren una sola vez por visita. */
    }
    <script>
      import "@/lib/cart-ui";
      import "@/lib/photo-fallback";
      import "@/lib/catalog-filter";
      import "@/lib/theme-ui";
    </script>
  </body>
</html>
