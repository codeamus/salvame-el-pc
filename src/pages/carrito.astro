---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CartView from "@/components/cart/CartView";

/*
 * On-demand con ISR.
 *
 * Su contenido —nombre del sitio, contacto, textos— sale de Supabase, y el
 * layout necesita esos datos para renderizar. Prerenderizarla la congelaría
 * con lo que hubiera en la base el día del deploy. Vercel cachea el HTML ya
 * generado, así que el visitante no nota diferencia.
 */
export const prerender = false;
---

<BaseLayout
  title="Tu carrito"
  description="Revisa los productos de tu carrito antes de ir al checkout."
>
  {/* client:load: es el contenido principal de la página, sin él no hay nada. */}
  <div class="min-h-[60vh]">
    <CartView client:load />
  </div>
</BaseLayout>
