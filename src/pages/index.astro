---
import ComingSoonLayout from "@/layouts/ComingSoonLayout.astro";

/**
 * ─────────────────────────────────────────────────────────────────────────
 * FASE "PRÓXIMAMENTE"
 * ─────────────────────────────────────────────────────────────────────────
 *
 * Hoy esta es la ÚNICA página que se publica. El sitio completo —portada con
 * bento, catálogo con filtros, ficha de producto, servicio técnico, contacto,
 * carrito y checkout— está terminado y vive en `src/pages/_wip/`.
 *
 * Astro no enruta carpetas que empiezan con guion bajo, así que esas páginas
 * no llegan al build: no es que estén ocultas, es que no existen en `dist/`.
 * Cualquier otra URL cae en 404 de verdad.
 *
 * PARA REACTIVAR EL SITIO COMPLETO:
 *   1. mv src/pages/_wip/* src/pages/     (sobrescribe este index.astro)
 *   2. mv e2e/_wip/* e2e/                 (devuelve los tests de las rutas)
 *   3. quitar `testIgnore` de playwright.config.ts
 */
---

<ComingSoonLayout
  title="Próximamente"
  description="Tienda de hardware, periféricos y servicio técnico en Santiago, Chile. Estamos por abrir."
>
  <section class="flex flex-1 flex-col justify-center px-5 py-16 sm:px-10 sm:py-24">
    <p class="eyebrow">Próximamente — Santiago, Chile</p>

    <h1
      class="mt-4.5 text-[clamp(52px,9vw,132px)] leading-[.94] font-extrabold tracking-[-.045em] text-balance uppercase"
    >
      Pronto<br />
      <span class="text-coral">salvamos tu PC.</span>
    </h1>

    <p class="mt-8 max-w-[46ch] text-[17px] leading-relaxed text-ink/75">
      Estamos armando la tienda: hardware, periféricos y servicio técnico, con despacho a todo
      Chile. En unos días vas a poder comprar y agendar tu reparación acá mismo.
    </p>
  </section>
</ComingSoonLayout>
