---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { campo, getSections } from "@/data/content";

/**
 * El comprador canceló en la pasarela.
 *
 * A propósito NO se vacía el carrito: cancelar suele ser "me falta revisar
 * algo", no "ya no quiero comprar". Que las cosas sigan ahí al volver es la
 * diferencia entre retomar la compra y abandonarla.
 */

/*
 * On-demand con ISR.
 *
 * Su contenido —nombre del sitio, contacto, textos— sale de Supabase, y el
 * layout necesita esos datos para renderizar. Prerenderizarla la congelaría
 * con lo que hubiera en la base el día del deploy. Vercel cachea el HTML ya
 * generado, así que el visitante no nota diferencia.
 */
export const prerender = false;

const secciones = await getSections("pago-cancelado");
---

<BaseLayout title="Pago cancelado" noindex>
  <section
    class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center gap-5 px-5 py-24 text-center"
  >
    <p class="font-mono text-[13px] text-muted">{campo(secciones, "contenido.label")}</p>
    <h1
      class="text-[clamp(32px,5.5vw,64px)] leading-[.98] font-extrabold tracking-[-.04em] uppercase"
    >
      {campo(secciones, "contenido.heading")}<br />{
        campo(secciones, "contenido.heading_line2")
      }<span class="text-coral">.</span>
    </h1>
    <p class="max-w-md text-[15px] text-ink/70">{campo(secciones, "contenido.body")}</p>

    <p class="font-mono text-xs text-muted" data-orden hidden>
      orden <span class="text-ink" data-orden-ref></span>
    </p>

    <div class="mt-4 flex flex-wrap justify-center gap-4">
      <a href={campo(secciones, "contenido.cta_primary_href", "/checkout")} class="btn-primary">
        {campo(secciones, "contenido.cta_primary_label")}
      </a>
      <a href={campo(secciones, "contenido.cta_secondary_href", "/carrito")} class="btn-secondary">
        {campo(secciones, "contenido.cta_secondary_label")}
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const orden = document.querySelector<HTMLElement>("[data-orden]");
  const ordenRef = document.querySelector<HTMLElement>("[data-orden-ref]");
  // TUU manda x_reference en la redirección; `ref` queda como alternativa.
  const params = new URLSearchParams(window.location.search);
  const referencia = params.get("x_reference") ?? params.get("ref");

  if (referencia !== null && referencia !== "" && orden && ordenRef) {
    ordenRef.textContent = referencia;
    orden.hidden = false;
  }
</script>
