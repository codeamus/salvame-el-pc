---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CheckoutView from "@/components/cart/CheckoutView";

/*
 * On-demand con ISR.
 *
 * Su contenido —nombre del sitio, contacto, textos— sale de Supabase, y el
 * layout necesita esos datos para renderizar. Prerenderizarla la congelaría
 * con lo que hubiera en la base el día del deploy. Vercel cachea el HTML ya
 * generado, así que el visitante no nota diferencia.
 */
export const prerender = false;
---

<BaseLayout
  title="Checkout"
  description="Completa tus datos de despacho y paga de forma segura con TUU."
>
  <div class="min-h-[60vh]">
    <CheckoutView client:load />
  </div>
</BaseLayout>
