---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createSupabaseAdminClient } from "@/lib/supabase/server";

export const prerender = false;

const supabase = createSupabaseAdminClient();
const { data: products } = await supabase
  .from("products")
  .select("id, name, brand, price_clp, stock, is_published")
  .order("created_at", { ascending: false });
---

<BaseLayout title="Admin · Productos">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Productos</h1>
      <a href="/admin/productos/nuevo" class="rounded-md bg-neutral-900 px-4 py-2 text-white">
        + Nuevo producto
      </a>
    </div>

    <table class="mt-6 w-full text-left text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-neutral-500">
          <th class="py-2">Nombre</th>
          <th>Marca</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Publicado</th>
        </tr>
      </thead>
      <tbody>
        {
          products?.map((p) => (
            <tr class="border-b border-neutral-100">
              <td class="py-2">{p.name}</td>
              <td>{p.brand}</td>
              <td>${p.price_clp.toLocaleString("es-CL")}</td>
              <td>{p.stock}</td>
              <td>{p.is_published ? "Sí" : "No"}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <!-- TODO: formulario de alta/edición en /admin/productos/nuevo — placeholder por ahora -->
  </main>
</BaseLayout>
