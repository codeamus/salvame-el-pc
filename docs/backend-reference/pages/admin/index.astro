---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createSupabaseAdminClient } from "@/lib/supabase/server";

// Protegido por src/middleware.ts — si llegamos acá, Astro.locals.session existe.
export const prerender = false;

const supabase = createSupabaseAdminClient();
const { count: pedidosPendientes } = await supabase
  .from("orders")
  .select("*", { count: "exact", head: true })
  .eq("status", "pagado");

const { count: totalProductos } = await supabase
  .from("products")
  .select("*", { count: "exact", head: true });
---

<BaseLayout title="Admin">
  <main class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-2xl font-bold">Panel administrativo</h1>

    <div class="mt-6 grid grid-cols-2 gap-4">
      <a href="/admin/pedidos" class="rounded-lg border border-neutral-200 p-6">
        <p class="text-sm text-neutral-500">Pedidos pagados por procesar</p>
        <p class="text-3xl font-bold">{pedidosPendientes ?? 0}</p>
      </a>
      <a href="/admin/productos" class="rounded-lg border border-neutral-200 p-6">
        <p class="text-sm text-neutral-500">Productos en catálogo</p>
        <p class="text-3xl font-bold">{totalProductos ?? 0}</p>
      </a>
    </div>
  </main>
</BaseLayout>
