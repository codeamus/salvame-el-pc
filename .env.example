# ─────────────────────────────────────────────────────────────────────────
# TUU PAGO ONLINE (Haulmer)
# ─────────────────────────────────────────────────────────────────────────
#
# Copia este archivo a .env para desarrollo local. El .env real está en el
# .gitignore y NUNCA se versiona.
#
# En Vercel se definen estos mismos nombres con valores distintos por
# environment (Production / Preview / Development). Por eso no hay ni un solo
# `if` de ambiente en el código: el deploy de producción trae las
# credenciales de producción y cualquier rama trae las de QA.
#
# Guía completa del flujo y checklist de producción: docs/pagos-tuu.md

# "qa"   → https://frontend-api.payment.haulmer.dev/v1/payment  (pagos simulados)
# "prod" → https://core.payment.haulmer.com/api/v1/payment      (plata real)
TUU_ENV=qa

# Credenciales. Las de QA son las públicas que TUU publica en su
# documentación: sirven para el ambiente de integración y no mueven dinero.
#
# ⚠️ Las de PRODUCCIÓN las entrega TUU al dar de alta la cuenta de comercio
# (a nombre de la empresa, con su RUT y su cuenta bancaria) y van SOLO en el
# environment Production de Vercel. Nunca en este archivo, nunca en el repo.
TUU_ACCOUNT_ID=62224230
TUU_SECRET_KEY=yAk0dXTJLQzkeEWODsQWVpPX0bn7ND50qwoQrXgqqNiUyEpgxIPxPtoCgKeLNeh1upTw72JZx5O9x5IaAtPIGUAVcMNcsUSg3M0M8tgWdUb4F8qkS8I7rHpOUmZqzvfS

# Nombre del comercio que ve el comprador en la pantalla de pago.
TUU_SHOP_NAME=Sálvame el PC (QA)

# Base pública del sitio: HTTPS y SIN slash final. De acá salen las URLs de
# callback y de retorno.
#
# localhost NO sirve: TUU tiene que poder llegar al callback desde internet.
# Para probar el flujo completo en local, levanta un túnel y pega su URL acá:
#
#   cloudflared tunnel --url http://localhost:4321
#
# En Vercel esta variable se puede omitir: el código se cae al dominio de
# producción o al alias estable de la rama (ver src/lib/tuu/env.ts).
PUBLIC_SITE_URL=https://tu-tunel.trycloudflare.com

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE (catálogo, CMS y pedidos)
# ─────────────────────────────────────────────────────────────────────────
#
# Las tres salen del dashboard: Project Settings → Data API (la URL) y
# Project Settings → API Keys (las dos claves).
#
# Correr primero supabase/schema.sql en el SQL Editor, y DESACTIVAR el
# registro público en Authentication → Sign In / Providers: con un solo
# usuario admin, cualquiera que se registre queda con permisos de escritura.
#
# ⚠️ NINGUNA lleva prefijo PUBLIC_, ni siquiera la clave pública.
#
# Vercel bloquea guardar un valor con pinta de secreto detrás de un prefijo
# que lo expone al navegador, y la clave "pública" de Supabase es un JWT: su
# heurística salta igual, aunque esa clave esté diseñada para ser pública.
#
# No es una limitación: es mejor así. Sin prefijo, Astro no la mete en
# ningún bundle. El panel de administración la recibe como prop desde su
# página, que se renderiza en el servidor — la clave llega solo a quien
# abre /admin, y no queda horneada en el JavaScript del sitio público.

# Base del proyecto. Sin slash final.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública ("Publishable key"; antes "anon").
#
# No es un secreto: lo único que protege los datos con esta clave es el Row
# Level Security definido en supabase/schema.sql. Verifícalo con
# `pnpm check:supabase`, que comprueba justamente que con esta clave NO se
# puede leer un pedido ni cerrar un pago.
SUPABASE_ANON_KEY=pega-aqui-la-clave-publica

# ⚠️ SECRETA de verdad. Clave de servicio ("Secret key"; antes "service_role").
#
# Pasa POR ENCIMA de todo el RLS: quien la tenga lee el nombre, RUT, correo,
# teléfono y dirección de cada comprador, y puede marcar pedidos como
# pagados.
#
# La usan únicamente las rutas de src/pages/api/**: crear la orden antes de
# ir a la pasarela y cerrarla cuando TUU confirma. Nunca en un componente.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-clave-secreta

# ─────────────────────────────────────────────────────────────────────────
# RESEND (correo transaccional)
# ─────────────────────────────────────────────────────────────────────────
#
# Dos cosas que el sitio tiene que poder mandar:
#
#   · La confirmación escrita de cada compra. NO es cortesía: la Ley 19.496
#     la exige, y sin ella el derecho a retracto del comprador pasa de 10 a
#     90 días corridos.
#   · El aviso de cada mensaje del formulario de contacto.
#
# Si faltan estas variables el sitio no se cae: las compras se cobran igual
# y los mensajes se guardan en la base. Lo que no ocurre es el aviso, y el
# panel lo muestra como pendiente para que se note.
#
# La API key se saca de resend.com → API Keys. ⚠️ Quien la tenga puede
# mandar correo EN NOMBRE del dominio del cliente: va solo en el servidor,
# nunca con prefijo PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. El dominio tiene que estar verificado en Resend con sus
# registros DNS, o los correos no salen.
#
# Se usa un SUBDOMINIO (envios.salvameelpc.cl) y no el dominio raíz a
# propósito: el raíz ya tiene Google Workspace con el correo humano del
# cliente. Separarlos evita que un problema de reputación del correo
# automático —una racha de rebotes, un reporte de spam— arrastre consigo la
# entrega del correo que las personas escriben a mano.
RESEND_FROM_EMAIL=Sálvame el PC <hola@envios.salvameelpc.cl>
