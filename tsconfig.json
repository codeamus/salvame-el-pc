{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "docs/backend-reference"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    // El proyecto es estricto por defecto (strictest ya activa noUncheckedIndexedAccess,
    // noImplicitOverride, exactOptionalPropertyTypes, etc.).
    "verbatimModuleSyntax": true,
    "allowJs": true
  }
}
